module electron.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";
import "mojo/public/mojom/base/string16.mojom";
import "mojo/public/mojom/base/unguessable_token.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "third_party/blink/public/mojom/messaging/transferable_message.mojom";

// A preload script and its contents, pushed to the renderer ahead of the
// document that needs it.
struct PreloadScriptData {
  string id;
  string file_path;
  // UTF-8 contents. array<uint8> rather than BigBuffer so RendererStartupData
  // can be flat-serialized into an opaque blob for the CreateNewWindowReply
  // path.
  array<uint8> contents;
  // Set if the file could not be read; surfaced via the 'preload-error' event.
  string? error;
  // V8 code cache, produced by the first renderer to compile this preload and
  // persisted under userData/Code Cache/electron-preload/. Only shipped when
  // its recorded source hash matches |contents|.
  array<uint8>? code_cache;
};

// Everything a sandboxed renderer needs to bootstrap a preload environment.
// process.arch/platform/version/versions are intentionally not here — they're
// filled renderer-side from node::per_process::metadata.
struct RendererStartupData {
  array<PreloadScriptData> preload_scripts;
  // Browser process.env, captured fresh per push.
  map<string, string> environment;
  string helper_exec_path;
};

// A value serialized with electron::SerializeV8Value(), in the buffer it is
// sent in. |buffer| may be larger than the |size| bytes that were written.
struct SerializedValue {
  mojo_base.mojom.BigBuffer buffer;
  uint64 size;
};

struct ScriptSource {
  mojo_base.mojom.String16 code;
  string url;
};

// Per-frame interface associated with content.mojom.Frame, so its messages and
// replies are ordered with navigation and the frame's other host messages:
// SetStartupData() arrives before the CommitNavigation that follows it, and a
// reply is seen after anything the frame told its host while handling the
// request.
interface ElectronFrame {
  SetStartupData(RendererStartupData data);

  // webContents.executeJavaScript() and friends. |result| is the script's
  // completion value (a thenable is awaited first) when |success|, otherwise
  // the value it threw or rejected with, unless |error| describes a failure
  // that produced no value. |world_id| 0 is the main world.
  ExecuteJavaScript(int32 world_id,
                    array<ScriptSource> sources,
                    bool has_user_gesture)
      => (bool success, SerializedValue result, string error);
  InsertCSS(string css, string css_origin) => (mojo_base.mojom.String16 key);
  RemoveInsertedCSS(mojo_base.mojom.String16 key) => ();
  InsertText(string text) => ();
  SetVisualZoomLevelLimits(double min_level, double max_level) => ();

  // sharedTexture.sendSharedTexture(): imports |transfer| (the result of
  // startTransferSharedTexture() in the browser) in the frame's Electron
  // context and hands it to the receiver registered with
  // sharedTexture.setSharedTextureReceiver() along with |args|. |result| is
  // the imported texture's frame creation sync token when |success|, otherwise
  // the error thrown, or |error| describes the failure.
  ReceiveSharedTexture(SerializedValue transfer,
                       string texture_id,
                       SerializedValue args)
      => (bool success, SerializedValue result, string error);
};

// Element info from Blink C++ (pierces closed shadow). backend_node_id matches
// CDP DOM BackendNodeId / blink::Node::GetDomNodeId().
struct DomElementInfo {
  int32 backend_node_id;
  string tag_name;
  // Bounds relative to the local RenderWidget (same space as BoundsInWidget).
  gfx.mojom.Rect bounds;
  // CSS pixels relative to the main-frame viewport (Input.dispatchMouseEvent).
  double x;
  double y;
  double width;
  double height;
};

// One iframe/frame whose content document should be searched next.
struct CrossDocumentHop {
  // LocalFrameToken when |is_local| (same process as the parent frame that
  // reported the hop); otherwise the RemoteFrameToken of the parent's proxy.
  mojo_base.mojom.UnguessableToken frame_token;
  bool is_local;
  string remainder_selector;
};

// Result of searching a single document. The browser follows |hops|.
struct CrossDocumentProbe {
  bool found;
  DomElementInfo? element;
  // True when the selector names an iframe/frame to step into. The browser
  // must not also scan unrelated child frames.
  bool explicit_frame_hop;
  array<CrossDocumentHop> hops;
};

// Box model in CSS pixels relative to the main-frame viewport (same space as
// Input.dispatchMouseEvent x/y).
struct DomBoxModel {
  int32 backend_node_id;
  double x;
  double y;
  double width;
  double height;
};

interface ElectronRenderer {
  Message(
      bool internal,
      string channel,
      SerializedValue arguments);

  ReceivePostMessage(string channel, blink.mojom.TransferableMessage message);

  TakeHeapSnapshot(handle file) => (bool success);

  // Query in Blink C++. Supports `>>>` pierce combinator; when |pierce| is true
  // also searches author open/closed shadow roots. Page JS cannot observe this.
  QuerySelectorDeep(string selector, bool pierce, bool scroll_into_view) =>
      (bool found, DomElementInfo? info);

  // Local step of a cross-document query. Either the element is in this
  // document (including author shadow), or |hops| names child frames whose
  // documents should be searched with |remainder_selector|.
  QuerySelectorAcrossDocuments(string selector,
                               bool pierce,
                               bool scroll_into_view) =>
      (CrossDocumentProbe result);

  // Resolve blink DomNodeId / CDP backendNodeId to a CSS-pixel box model.
  GetNodeBoxModel(int32 backend_node_id, bool scroll_into_view) =>
      (bool found, DomBoxModel? model);

  // Set files on <input type=file> without debugger (CDP DOM.setFileInputFiles).
  // When |backend_node_id| is non-zero it is used; otherwise |selector| is
  // resolved with the same pierce rules as QuerySelectorDeep.
  SetFileInputFiles(string selector,
                    int32 backend_node_id,
                    bool pierce,
                    array<string> paths) => (bool ok, string error);
};

interface ElectronAutofillAgent {
  AcceptDataListSuggestion(mojo_base.mojom.String16 value);
};

interface ElectronAutofillDriver {
  ShowAutofillPopup(gfx.mojom.RectF bounds, array<mojo_base.mojom.String16> values, array<mojo_base.mojom.String16> labels);
  HideAutofillPopup();
};

interface ElectronApiIPC {
  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process.
  Message(
      bool internal,
      string channel,
      SerializedValue arguments);

  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process, and returns the response.
  Invoke(
      bool internal,
      string channel,
      SerializedValue arguments) => (SerializedValue result);

  ReceivePostMessage(string channel, blink.mojom.TransferableMessage message);

  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process, and waits synchronously for a response.
  [Sync]
  MessageSync(
    bool internal,
    string channel,
    SerializedValue arguments) => (SerializedValue result);

  MessageHost(
    string channel,
    SerializedValue arguments);
};
