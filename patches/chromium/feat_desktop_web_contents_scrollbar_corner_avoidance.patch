+namespace {
+// Use the scrollbar frame itself for avoidance: paint, compositor geometry,
+// dragging and hit testing then share one source of truth. Author scrollbars,
+// subframes and nested overflow boxes are intentionally left alone.
+int DesktopScrollbarCornerInset(const LayoutBox& box,
+                                const Scrollbar& scrollbar) {
+  const auto* frame = box.GetFrame();
+  if (!box.IsLayoutView() || !frame || !frame->IsMainFrame() ||
+      !frame->GetPage() || scrollbar.IsCustomScrollbar()) {
+    return 0;
+  }
+  const auto& prefs = frame->GetPage()->GetRendererPreferences();
+  if (!prefs.desktop_scrollbar_corner_avoidance) {
+    return 0;
+  }
+  // Layout scrollbar coordinates include device scale, not CSS page zoom.
+  return base::ClampCeil(prefs.desktop_scrollbar_corner_radius *
+                         scrollbar.ScaleFromDIP());
+}
+
+gfx::Rect AvoidDesktopScrollbarCorners(gfx::Rect rect,
+                                       int radius,
+                                       int adjacent_scrollbar,
+                                       bool vertical) {
+  if (radius <= 0) {
+    return rect;
+  }
+  const int length = vertical ? rect.height() : rect.width();
+  const int start = std::min(radius, length / 2);
+  const int end =
+      std::min(std::max(0, radius - adjacent_scrollbar), length - start);
+  if (vertical) {
+    rect.set_y(rect.y() + start);
+    rect.set_height(length - start - end);
+  } else {
+    rect.set_x(rect.x() + start);
+    rect.set_width(length - start - end);
+  }
+  return rect;
+}
+}  // namespace
