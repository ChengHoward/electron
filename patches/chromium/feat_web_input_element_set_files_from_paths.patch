From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chuanchuan <example@gmail.com>
Date: Mon, 21 Sep 2026 07:50:00 +0800
Subject: feat: WebInputElement.SetFilesFromPaths for Electron setFileInputFiles

Expose HTMLInputElement::SetFilesFromPaths on WebInputElement so
Electron can set <input type=file> without CDP debugger.attach.

diff --git a/third_party/blink/public/web/web_input_element.h b/third_party/blink/public/web/web_input_element.h
index 67d05800d90ad..4b0f025bb9f99 100644
--- a/third_party/blink/public/web/web_input_element.h
+++ b/third_party/blink/public/web/web_input_element.h
@@ -90,6 +90,10 @@ class BLINK_EXPORT WebInputElement final : public WebFormControlElement {
   // Triggers a form submission.
   void DispatchSimulatedEnter();
 
+  // Sets the file list on an <input type=file> from absolute filesystem paths
+  // (same behavior as CDP DOM.setFileInputFiles). No-op when |paths| is empty.
+  void SetFilesFromPaths(const std::vector<WebString>& paths);
+
 #if INSIDE_BLINK
   explicit WebInputElement(HTMLInputElement*);
   WebInputElement& operator=(HTMLInputElement*);
diff --git a/third_party/blink/renderer/core/exported/web_input_element.cc b/third_party/blink/renderer/core/exported/web_input_element.cc
index 5147fece64f63..35fcf90c16699 100644
--- a/third_party/blink/renderer/core/exported/web_input_element.cc
+++ b/third_party/blink/renderer/core/exported/web_input_element.cc
@@ -113,6 +113,14 @@ void WebInputElement::DispatchSimulatedEnter() {
   Unwrap<HTMLInputElement>()->DispatchSimulatedEnter();
 }
 
+void WebInputElement::SetFilesFromPaths(const std::vector<WebString>& paths) {
+  Vector<String> path_strings;
+  for (const auto& path : paths)
+    path_strings.push_back(path);
+  Unwrap<HTMLInputElement>()->SetFilesFromPaths(path_strings);
+}
+
 WebInputElement::WebInputElement(HTMLInputElement* elem)
     : WebFormControlElement(elem) {}
 
