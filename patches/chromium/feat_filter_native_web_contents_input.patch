+void RenderWidgetHostViewAura::SetNativeInputFilter(
+    base::RepeatingCallback<bool(bool)> filter) {
+  const bool was_blocked = native_keyboard_blocked_;
+  native_input_filter_ = std::move(filter);
+  native_keyboard_blocked_ = IsNativeInputBlocked(true);
+  auto* input_method = GetInputMethod();
+  if (!input_method || input_method->GetTextInputClient() != this)
+    return;
+  if (was_blocked || native_keyboard_blocked_)
+    input_method->CancelComposition(this);
+  input_method->OnTextInputTypeChanged(this);
+}
