+void RenderWidgetHostInputEventRouter::FindMouseEventTargetAndCallback(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event,
+    RenderWidgetHostViewInput* target_hint,
+    const std::optional<gfx::PointF>& target_location_hint,
+    RenderWidgetTargeter::RenderWidgetHostAtPointCallback callback) {
+  if (!IsViewInMap(root_view) ||
+      !blink::WebInputEvent::IsMouseEventType(event.GetType()) ||
+      !std::isfinite(event.PositionInWidget().x()) ||
+      !std::isfinite(event.PositionInWidget().y())) {
+    std::move(callback).Run({}, std::nullopt);
+    return;
+  }
+
+  const bool has_capture =
+      mouse_capture_target_ &&
+      (event.GetType() == blink::WebInputEvent::Type::kMouseUp ||
+       IsMouseButtonDown(event));
+  if (target_hint && !route_to_root_for_devtools_ &&
+      !root_view->IsPointerLocked() && !has_capture) {
+    if (!IsViewInMap(target_hint) ||
+        (target_hint != root_view &&
+         !RenderWidgetHostViewInput::IsAncestorView(target_hint, root_view)) ||
+        !target_location_hint || !std::isfinite(target_location_hint->x()) ||
+        !std::isfinite(target_location_hint->y())) {
+      std::move(callback).Run({}, std::nullopt);
+      return;
+    }
+    if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+      mouse_down_pre_transformed_coordinate_ = event.PositionInWidget();
+    }
+    std::move(callback).Run(target_hint->GetInputWeakPtr(),
+                            target_location_hint);
+    return;
+  }
+
+  event_targeter_->FindTargetAndCallback(
+      root_view, event,
+      base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostInputEventRouter> router,
+             base::WeakPtr<RenderWidgetHostViewInput> root,
+             RenderWidgetTargeter::RenderWidgetHostAtPointCallback callback,
+             base::WeakPtr<RenderWidgetHostViewInput> target,
+             std::optional<gfx::PointF> point) {
+            if (!router || !router->IsViewInMap(root.get()) ||
+                !router->IsViewInMap(target.get()) ||
+                (target.get() != root.get() &&
+                 !RenderWidgetHostViewInput::IsAncestorView(target.get(),
+                                                            root.get())) ||
+                !point || !std::isfinite(point->x()) ||
+                !std::isfinite(point->y())) {
+              std::move(callback).Run({}, std::nullopt);
+              return;
+            }
+            std::move(callback).Run(std::move(target), point);
+          },
+          GetWeakPtr(), root_view->GetInputWeakPtr(), std::move(callback)));
+}
+
+bool RenderWidgetHostInputEventRouter::DispatchMouseEventToTarget(
+    RenderWidgetHostViewInput* root_view,
+    RenderWidgetHostViewInput* target,
+    blink::WebMouseEvent* event,
+    const ui::LatencyInfo& latency,
+    const std::optional<gfx::PointF>& target_location) {
+  if (!event || !blink::WebInputEvent::IsMouseEventType(event->GetType()) ||
+      !IsViewInMap(root_view) || !IsViewInMap(target) ||
+      !std::isfinite(event->PositionInWidget().x()) ||
+      !std::isfinite(event->PositionInWidget().y()) ||
+      (target != root_view &&
+       !RenderWidgetHostViewInput::IsAncestorView(target, root_view)) ||
+      !target_location || !std::isfinite(target_location->x()) ||
+      !std::isfinite(target_location->y())) {
+    return false;
+  }
+  scoped_refptr<RenderWidgetHostInputEventRouter> keep_alive(this);
+  base::AutoReset<bool> injected_dispatch(&dispatching_injected_mouse_, true);
+  DispatchEventToTarget(root_view, target, event, latency, target_location);
+  return true;
+}
