@@ -1632,6 +1638,11 @@ class CONTENT_EXPORT RenderWidgetHostImpl
   // causing HasFocus to return false when is_focused_ is true.
   bool is_focused_ = false;
 
+  // Preserve native requests while isolated renderer focus remains effective.
+  bool native_page_focused_ = false;
+  bool native_page_active_ = false;
+  bool input_isolation_enabled_ = false;
+
   bool focus_emulation_enabled_ = false;
 
