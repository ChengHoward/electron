+
+TEST(ProxySpecificationUtilTest, ProxyUriCarriesAuthAndHidesItFromDebugStrings) {
+  const ProxyServer proxy = ProxyUriToProxyServer(
+      "socks5://user:p%40ss@127.0.0.1:1080", ProxyServer::SCHEME_HTTP);
+  EXPECT_TRUE(proxy.is_valid());
+  EXPECT_EQ(ProxyServer::SCHEME_SOCKS5, proxy.scheme());
+  EXPECT_EQ("127.0.0.1", proxy.GetHost());
+  EXPECT_EQ(1080, proxy.GetPort());
+  EXPECT_EQ("user", proxy.username());
+  EXPECT_EQ("p@ss", proxy.password());
+  EXPECT_EQ("socks5://127.0.0.1:1080", ProxyServerToProxyUri(proxy));
+  EXPECT_EQ("SOCKS5 127.0.0.1:1080", ProxyServerToPacResultElement(proxy));
+}
+
+TEST(ProxySpecificationUtilTest, ApplyProxyAuthToProxyRules) {
+  EXPECT_EQ(
+      "http://user:p%40ss%20word@myproxy:80",
+      ApplyProxyAuthToProxyRules("http://myproxy:80", "user", "p@ss word"));
+  EXPECT_EQ("http=user:pass@foopy:80,direct://",
+            ApplyProxyAuthToProxyRules("http=foopy:80,direct://", "user",
+                                       "pass"));
+  EXPECT_EQ(
+      "http=user:secret@myproxy:80;https=socks5://user:secret@bar:1080",
+      ApplyProxyAuthToProxyRules("http=myproxy:80;https=socks5://bar:1080",
+                                 "user", "secret"));
+  EXPECT_EQ("socks5://keep:me@host:1",
+            ApplyProxyAuthToProxyRules("socks5://keep:me@host:1", "", ""));
+
+  ProxyConfig::ProxyRules rules;
+  rules.ParseFromString(
+      ApplyProxyAuthToProxyRules("http=myproxy:80,direct://", "alice", "s3cret"));
+  ASSERT_FALSE(rules.proxies_for_http.IsEmpty());
+  const ProxyChain& chain = rules.proxies_for_http.First();
+  ASSERT_TRUE(chain.IsValid());
+  ASSERT_FALSE(chain.is_direct());
+  EXPECT_EQ("alice", chain.First().username());
+  EXPECT_EQ("s3cret", chain.First().password());
+  EXPECT_EQ("myproxy", chain.First().GetHost());
+}
+
 }  // namespace
 }  // namespace net
