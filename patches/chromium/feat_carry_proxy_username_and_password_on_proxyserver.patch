+std::string ProxyServer::GetAuthUserinfo() const {
+  if (!has_auth_credentials()) {
+    return std::string();
+  }
+  return base::StrCat({EscapeProxyUserinfoComponent(username_), ":",
+                       EscapeProxyUserinfoComponent(password_)});
+}
+
+std::string ApplyProxyAuthToProxyRules(std::string_view proxy_rules,
+                                      std::string_view username,
+                                      std::string_view password) {
+  if (username.empty() && password.empty()) {
+    return std::string(proxy_rules);
+  }
+  const std::string userinfo = base::StrCat(
+      {EscapeProxyUserinfoComponent(username), ":",
+       EscapeProxyUserinfoComponent(password)});
+
+  std::string out;
+  for (std::string_view group : SplitOutsideBrackets(proxy_rules, ';')) {
+    group = HttpUtil::TrimLWS(group);
+    if (group.empty()) {
+      continue;
+    }
+    if (!out.empty()) {
+      out.push_back(';');
+    }
+
+    int depth = 0;
+    size_t equals = std::string_view::npos;
+    for (size_t i = 0; i < group.size(); ++i) {
+      if (group[i] == '[') {
+        ++depth;
+      } else if (group[i] == ']' && depth > 0) {
+        --depth;
+      } else if (group[i] == '=' && depth == 0) {
+        equals = i;
+        break;
+      }
+    }
+    if (equals != std::string_view::npos) {
+      const std::string_view left =
+          HttpUtil::TrimLWS(group.substr(0, equals));
+      if (IsProxyRulesUrlScheme(left)) {
+        out += left;
+        out.push_back('=');
+        out += RewriteProxyListWithUserinfo(group.substr(equals + 1), userinfo);
+        continue;
+      }
+    }
+    out += RewriteProxyListWithUserinfo(group, userinfo);
+  }
+  return out;
 }
 
