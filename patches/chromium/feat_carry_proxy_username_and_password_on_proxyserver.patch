+bool IsUnreservedUserinfoChar(unsigned char c) {
+  return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+         (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_' || c == '~';
+}
+
+std::string EscapeProxyUserinfoComponent(std::string_view raw) {
+  std::string out;
+  out.reserve(raw.size());
+  for (unsigned char c : raw) {
+    if (IsUnreservedUserinfoChar(c)) {
+      out.push_back(static_cast<char>(c));
+    } else {
+      base::StringAppendF(&out, "%%%02X", c);
+    }
+  }
+  return out;
+}
+
+std::string DecodeProxyUserinfoComponent(std::string_view escaped) {
+  std::string decoded;
+  if (!base::UnescapeBinaryURLComponentSafe(
+          escaped, /*fail_on_path_separators=*/false, &decoded)) {
+    return std::string(escaped);
+  }
+  return decoded;
+}
+
+bool IsProxyRulesUrlScheme(std::string_view scheme) {
+  return base::EqualsCaseInsensitiveASCII(scheme, "http") ||
+         base::EqualsCaseInsensitiveASCII(scheme, "https") ||
+         base::EqualsCaseInsensitiveASCII(scheme, "ftp") ||
+         base::EqualsCaseInsensitiveASCII(scheme, "socks");
+}
+
+// Splits |input| on |delim| without splitting inside [] groups.
+std::vector<std::string_view> SplitOutsideBrackets(std::string_view input,
+                                                   char delim) {
+  std::vector<std::string_view> parts;
+  int depth = 0;
+  size_t start = 0;
+  for (size_t i = 0; i < input.size(); ++i) {
+    if (input[i] == '[') {
+      ++depth;
+    } else if (input[i] == ']' && depth > 0) {
+      --depth;
+    } else if (input[i] == delim && depth == 0) {
+      parts.push_back(input.substr(start, i - start));
+      start = i + 1;
+    }
+  }
+  parts.push_back(input.substr(start));
+  return parts;
+}
+
+std::string RewriteProxyUriWithUserinfo(std::string_view uri,
+                                        std::string_view userinfo) {
+  uri = HttpUtil::TrimLWS(uri);
+  if (uri.empty() ||
+      base::EqualsCaseInsensitiveASCII(uri, "direct") ||
+      base::StartsWith(uri, "direct://",
+                       base::CompareCase::INSENSITIVE_ASCII)) {
+    return std::string(uri);
+  }
+
+  std::string_view scheme;
+  std::string_view rest = uri;
+  const size_t scheme_end = uri.find("://");
+  if (scheme_end != std::string_view::npos) {
+    scheme = uri.substr(0, scheme_end + 3);
+    rest = uri.substr(scheme_end + 3);
+  }
+  // Drop userinfo already present so the configured credentials replace it.
+  const size_t at = rest.rfind('@');
+  if (at != std::string_view::npos) {
+    rest = rest.substr(at + 1);
+  }
+  return base::StrCat({scheme, userinfo, "@", rest});
+}
+
+std::string RewriteProxyListWithUserinfo(std::string_view list,
+                                         std::string_view userinfo) {
+  list = HttpUtil::TrimLWS(list);
+  const bool bracketed =
+      list.size() >= 2 && list.front() == '[' && list.back() == ']';
+  std::string_view tokens = list;
+  char delim = ',';
+  std::string prefix;
+  std::string suffix;
+  if (bracketed) {
+    tokens = HttpUtil::TrimLWS(list.substr(1, list.size() - 2));
+    delim = ' ';
+    prefix = "[";
+    suffix = "]";
+  }
+
+  std::string out = prefix;
+  bool first = true;
+  for (std::string_view part : SplitOutsideBrackets(tokens, delim)) {
+    part = HttpUtil::TrimLWS(part);
+    if (part.empty()) {
+      continue;
+    }
+    if (!first) {
+      out.push_back(delim == ' ' ? ' ' : ',');
+    }
+    first = false;
+    out += RewriteProxyUriWithUserinfo(part, userinfo);
+  }
+  out += suffix;
+  return out;
+}
